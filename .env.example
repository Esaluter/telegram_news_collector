# Telegram bot token from BotFather. Do not run this bot alongside another
# long-polling process that uses the same token.
TELEGRAM_BOT_TOKEN=

# Numeric ID of the only Telegram group accepted by the collector.
GROUP_ID=

# Deployed Google Apps Script Web App /exec URL and shared application secret.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec
GOOGLE_APPS_SCRIPT_SECRET=

# Optional runtime settings.
ARCHIVE_PATH=data/group_news.json
SYNC_BATCH_SIZE=50
SYNC_RETRY_SECONDS=60
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

